# ==============================================================================
# Aura AI - Personal AI Companion, Friend & Guide
# Environment Configuration
# ==============================================================================

# [PRIMARY] Google Gemini API Key (Recommended)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# [OPTIONAL] Preferred Gemini Model (Defaults to gemini-1.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# [OPTIONAL] Custom App Name and Persona Branding
NEXT_PUBLIC_APP_NAME="Aura AI"
NEXT_PUBLIC_APP_TAGLINE="Your Personal AI Friend & Guide"

# [OPTIONAL] Server Configuration
PORT=3000
NODE_ENV=development
